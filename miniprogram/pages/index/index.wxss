/* ============ 主题变量 ============ */
.page {
  /* 浅色 */
  --bg: #f3f5f9;
  --bg-card: #ffffff;
  --bg-inset: #e9edf4;
  --text: #1c2333;
  --text-sub: #6b7487;
  --border: #dde3ee;
  --primary: #4f6ef7;
  --primary-weak: #e4e9fe;
  --success: #2fa96e;
  --success-weak: #e0f5ea;
  --danger: #e5484d;
  --danger-weak: #fde8e9;
  --cell-bg: #ffffff;
  --cell-border: #d6dceb;
  --cell-text: #2a3350;
  --cell-done-bg: #eef1f7;
  --cell-done-text: #b6bdd0;
  --overlay: rgba(243, 245, 249, 0.6);
  --shadow: 0 8rpx 32rpx rgba(28, 35, 51, 0.08);
  --radius: 28rpx;

  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 20rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page.dark {
  --bg: #12151d;
  --bg-card: #1b2030;
  --bg-inset: #232a3d;
  --text: #e8ebf4;
  --text-sub: #8f98ad;
  --border: #2c344a;
  --primary: #6d87ff;
  --primary-weak: #26304f;
  --success: #3ecf8e;
  --success-weak: #17362a;
  --danger: #ff6369;
  --danger-weak: #3d2023;
  --cell-bg: #232a3d;
  --cell-border: #333c55;
  --cell-text: #e8ebf4;
  --cell-done-bg: #1a2030;
  --cell-done-text: #4a5470;
  --overlay: rgba(18, 21, 29, 0.6);
  --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* ============ 顶部操作栏 ============ */
.topbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.icon-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}

.icon-btn:active {
  transform: scale(0.94);
}

/* ============ 模式选择区 ============ */
.mode-bar {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.mode-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: var(--bg-card);
  border: 3rpx solid var(--border);
}

.mode-btn:active {
  transform: scale(0.95);
}

.mode-btn.active {
  border-color: var(--primary);
  background: var(--primary-weak);
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
}

.mode-btn.active .mode-name {
  color: var(--primary);
}

.mode-best {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* ============ 设置开关 ============ */
.settings {
  display: flex;
  gap: 36rpx;
  justify-content: center;
  margin-bottom: 20rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

/* ============ 状态栏 ============ */
.status-bar {
  display: flex;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 20rpx 12rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.stat-sub {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-sub);
}

.stat-target {
  color: var(--primary);
  font-size: 40rpx;
}

/* ============ 游戏区 ============ */
.board-wrap {
  position: relative;
  width: 686rpx;
  margin: 0 auto;
}

.board {
  display: grid;
  width: 686rpx;
  height: 686rpx;
  font-size: var(--cell-font);
}

.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cell-bg);
  border: 3rpx solid var(--cell-border);
  border-radius: 20rpx;
  font-weight: 700;
  color: var(--cell-text);
  font-variant-numeric: tabular-nums;
  font-size: var(--cell-font);
  line-height: 1;
  text-align: center;
}

.cell.done {
  background: var(--cell-done-bg);
  border-color: transparent;
  color: var(--cell-done-text);
}

.cell.hit {
  background: var(--success-weak);
  border-color: var(--success);
  color: var(--success);
}

.cell.wrong {
  animation: shake 0.3s, wrongflash 0.3s;
}

.cell.hint {
  animation: breath 1.4s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-6rpx); }
}

@keyframes wrongflash {
  0%, 100% { background: var(--cell-bg); }
  40% { background: var(--danger-weak); border-color: var(--danger); color: var(--danger); }
}

@keyframes breath {
  0%, 100% { box-shadow: 0 0 0 0 rgba(79, 110, 247, 0); border-color: var(--cell-border); }
  50% { box-shadow: 0 0 0 10rpx rgba(79, 110, 247, 0.25); border-color: var(--primary); }
}

/* ============ 开始遮罩 ============ */
.start-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--overlay);
  border-radius: var(--radius);
  z-index: 5;
}

.start-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.start-title {
  font-size: 32rpx;
  font-weight: 600;
}

.start-title .hl {
  color: var(--primary);
}

.start-hint {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* ============ 按钮 ============ */
.btn {
  margin: 0;
  padding: 20rpx 44rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
}

.btn-ghost {
  background: var(--bg-inset);
  color: var(--text);
}

.btn-danger-ghost {
  margin: 24rpx auto 0;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  background: none;
  color: var(--danger);
  border: 2rpx solid var(--danger-weak);
  font-size: 26rpx;
  line-height: 1.4;
}

.btn-danger-ghost::after {
  border: none;
}

/* ============ 结果浮层 ============ */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 14, 24, 0.45);
  z-index: 20;
  animation: fadein 0.2s;
}

.modal-card {
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 56rpx 60rpx;
  width: 588rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  animation: popin 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes fadein {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popin {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

.result-emoji {
  font-size: 88rpx;
  line-height: 1;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
}

.result-record {
  color: var(--success);
  font-weight: 700;
  font-size: 30rpx;
}

.result-stats {
  display: flex;
  width: 100%;
  background: var(--bg-inset);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
}

.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.result-stat-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.result-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

/* ============ 历史抽屉 ============ */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 14, 24, 0.4);
  z-index: 30;
  animation: fadein 0.2s;
}

.drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 660rpx;
  background: var(--bg-card);
  z-index: 31;
  box-sizing: border-box;
  padding: 36rpx;
  animation: slidein 0.25s cubic-bezier(0.25, 1, 0.4, 1);
  box-shadow: -16rpx 0 48rpx rgba(0, 0, 0, 0.15);
}

@keyframes slidein {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.drawer-title {
  font-size: 36rpx;
  font-weight: 700;
}

.drawer-section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.best-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.best-item {
  width: 286rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.best-mode {
  font-size: 26rpx;
  font-weight: 600;
}

.best-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
}

.rec-mode {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rec-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.rec-meta {
  font-size: 22rpx;
  color: var(--text-sub);
  text-align: right;
  min-width: 0;
}

.record-empty {
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* ============ 底部提示 ============ */
.foot-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 24rpx;
}
