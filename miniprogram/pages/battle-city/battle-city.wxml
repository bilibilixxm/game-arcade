<view class="page {{darkClass}}">

  <!-- 顶部操作栏(标题由小程序导航栏提供) -->
  <view class="topbar">
    <view class="icon-btn" bindtap="onThemeTap" aria-label="切换主题">{{themeIcon}}</view>
    <view class="icon-btn" bindtap="onPauseTap" aria-label="暂停/继续">{{pauseIcon}}</view>
    <view class="icon-btn" bindtap="onHistoryTap" aria-label="历史记录">📊</view>
  </view>

  <!-- 状态栏 -->
  <view class="status-bar">
    <view class="stat">
      <text class="stat-label">分数</text>
      <text class="stat-value">{{displayScore}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">关卡</text>
      <text class="stat-value">{{stageNum}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">敌军</text>
      <text class="stat-value">{{enemyCount}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">最高分</text>
      <text class="stat-value">{{bestText}}</text>
    </view>
  </view>

  <!-- 战场(放大,独占整行) -->
  <view class="board-wrap">
    <canvas type="2d" id="board" class="board"></canvas>
    <!-- 开始遮罩 -->
    <view class="start-overlay" wx:if="{{overlayVisible}}">
      <view class="start-card">
        <view class="start-title">保卫基地 · 消灭 20 辆敌军坦克</view>
        <view class="level-pick">
          <text class="level-label">起始关卡</text>
          <view class="level-btn" bindtap="onStageDown" hover-class="level-btn-hover">−</view>
          <text class="level-num">{{startStage}}</text>
          <view class="level-btn" bindtap="onStageUp" hover-class="level-btn-hover">＋</view>
        </view>
        <view class="brick-toggle" bindtap="onBrickTap">砖块:{{brickWhole ? '一击整块' : '经典咬痕'}}</view>
        <view class="start-hint">基地被毁或生命耗尽即失败 · 击毁闪红敌坦可获道具</view>
        <button class="btn btn-primary" bindtap="onStartTap">开始游戏</button>
      </view>
    </view>
    <!-- 暂停遮罩 -->
    <view class="start-overlay" wx:if="{{pauseVisible}}">
      <view class="start-card">
        <view class="start-title">已暂停</view>
        <button class="btn btn-primary" bindtap="onResumeTap">继续</button>
        <button class="btn btn-ghost" bindtap="onFinishTap">结束本局</button>
      </view>
    </view>
  </view>

  <!-- 信息条:敌军 / 基地 / 生命 / 火力 -->
  <view class="info-row">
    <view class="panel">
      <text class="panel-label">敌军</text>
      <canvas type="2d" id="cv-enemy" class="preview enemy-preview"></canvas>
    </view>
    <view class="side-box">
      <text class="side-label">基地</text>
      <view class="base-state {{baseAlive ? '' : 'destroyed'}}">{{baseAlive ? '🦅' : '💥'}}</view>
    </view>
    <view class="side-box">
      <text class="side-label">生命</text>
      <view class="side-value">{{livesText}}</view>
    </view>
    <view class="side-box">
      <text class="side-label">火力</text>
      <view class="side-value">{{powerText}}</view>
    </view>
  </view>

  <!-- 触控:摇杆 + FIRE -->
  <view class="touch-controls">
    <view
      class="joy"
      bindtouchstart="onJoyStart"
      catchtouchmove="onJoyMove"
      bindtouchend="onJoyEnd"
      bindtouchcancel="onJoyEnd"
    >
      <view class="joy-knob" style="transform: translate({{stickX}}px, {{stickY}}px);"></view>
    </view>
    <view
      class="tc-fire {{pressed.fire ? 'pressing' : ''}}"
      bindtouchstart="onFireDown"
      bindtouchend="onFireUp"
      bindtouchcancel="onFireUp"
    >FIRE</view>
  </view>

  <view class="foot-tip">摇杆移动 · FIRE 开火 · 保卫你的基地 🦅</view>

  <!-- 结果浮层 -->
  <view class="modal" wx:if="{{resultVisible}}" catchtouchmove="noop">
    <view class="modal-card">
      <view class="result-emoji">{{resultEmoji}}</view>
      <view class="result-title">{{resultTitle}}</view>
      <view class="result-record" wx:if="{{isNewRecord}}">🏆 新纪录!</view>
      <view class="result-stats">
        <view class="result-stat">
          <text class="result-stat-label">本次得分</text>
          <text class="result-stat-value">{{resultScore}}</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-label">到达关卡</text>
          <text class="result-stat-value">{{resultStage}}</text>
        </view>
      </view>
      <view class="result-sub">用时 {{resultDuration}} · 历史最佳 {{resultBest}}</view>
      <view class="modal-actions">
        <button class="btn btn-primary" bindtap="onRetryTap">再来一局</button>
        <button class="btn btn-ghost" bindtap="onHistoryTap">查看历史</button>
      </view>
    </view>
  </view>

  <!-- 历史抽屉 -->
  <view class="drawer-mask" wx:if="{{drawerVisible}}" bindtap="onCloseDrawer" catchtouchmove="noop"></view>
  <scroll-view class="drawer" wx:if="{{drawerVisible}}" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="drawer-header">
      <view class="drawer-title">历史记录</view>
      <view class="icon-btn" bindtap="onCloseDrawer">✕</view>
    </view>

    <view class="drawer-section">
      <view class="section-title">历史最佳</view>
      <view class="best-summary">
        <view class="result-stat">
          <text class="result-stat-label">最高分</text>
          <text class="result-stat-value">{{drawerBestScore}}</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-label">最远关卡</text>
          <text class="result-stat-value">{{drawerBestLevel}}</text>
        </view>
      </view>
    </view>

    <view class="drawer-section">
      <view class="section-title">最近对局</view>
      <view class="record-list" wx:if="{{records.length > 0}}">
        <view class="record-item" wx:for="{{records}}" wx:key="key">
          <text class="rec-score">{{item.scoreText}} 分</text>
          <text class="rec-meta">{{item.metaText}}</text>
        </view>
      </view>
      <view class="record-empty" wx:else>暂无对局记录,快开始第一局吧!</view>
      <button class="btn-danger-ghost" bindtap="onClearTap">清空全部记录</button>
    </view>
  </scroll-view>
</view>
