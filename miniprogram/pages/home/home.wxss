/* ============ 主题变量(与 schulte 页一致) ============ */
.page {
  /* 浅色 */
  --bg: #f3f5f9;
  --bg-card: #ffffff;
  --bg-inset: #e9edf4;
  --text: #1c2333;
  --text-sub: #6b7487;
  --border: #dde3ee;
  --primary: #4f6ef7;
  --primary-weak: #e4e9fe;
  --shadow: 0 8rpx 32rpx rgba(28, 35, 51, 0.08);
  --radius: 28rpx;

  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 20rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page.dark {
  --bg: #12151d;
  --bg-card: #1b2030;
  --bg-inset: #232a3d;
  --text: #e8ebf4;
  --text-sub: #8f98ad;
  --border: #2c344a;
  --primary: #6d87ff;
  --primary-weak: #26304f;
  --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* ============ 顶部操作栏 ============ */
.topbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.icon-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}

.icon-btn:active {
  transform: scale(0.94);
}

/* ============ 头部 ============ */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0 40rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* ============ 游戏列表 ============ */
.game-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.game-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
  transition: transform 0.1s;
}

.game-card:active {
  transform: scale(0.98);
}

.game-card.soon {
  opacity: 0.62;
}

.game-icon {
  font-size: 60rpx;
  line-height: 1;
  flex-shrink: 0;
}

.game-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.game-name {
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.soon-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-sub);
  background: var(--bg-inset);
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}

.game-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.game-best {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.best-value {
  color: var(--primary);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.game-arrow {
  font-size: 44rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

/* ============ 底部提示 ============ */
.foot-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 40rpx;
}
